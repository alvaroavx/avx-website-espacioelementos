---
import { Image } from 'astro:assets';
import LatinRengoSocialLayout from '../layouts/LatinRengoSocialLayout.astro';
import {
	archivePath,
	createEventJsonLd,
	formatCLP,
	latinRengoSocialEvent as event,
	menuPath,
	publicFaqItems,
	publicPresentationSchedule,
	publicSchedule,
	publicTickets,
} from '../content/social';

const pageTitle = 'LatinRengo Social - Primer aniversario';
const pageDescription =
	'Guía pública de LatinRengo Social: fecha, programa, artistas, entradas, menú y contacto autorizado.';
---

<LatinRengoSocialLayout
	title={pageTitle}
	description={pageDescription}
	canonicalPath="/latin-rengo-social"
	jsonLd={createEventJsonLd()}
>
	<main id="contenido" data-latin-rengo class="lr-page lr-guide">
		<section class="lr-hero" aria-labelledby="lr-title">
			<div class="lr-hero__inner">
				<p class="lr-eyebrow">{event.edition}</p>
				<h1 id="lr-title">{event.shortName}</h1>
				<div class="lr-hero__facts" aria-label="Resumen del evento">
					<p>
						<time datetime="2026-07-18">{event.dateLabel}</time>
					</p>
					<p>{event.venueName}</p>
					<p>{event.quickSummary}</p>
				</div>
				<nav class="lr-quick-nav" aria-label="Accesos rápidos">
					<a href="#programa">Programación</a>
					<a href={menuPath}>Menú</a>
					<a href="#entradas">Entradas</a>
					<a href="#contacto">Contacto</a>
				</nav>
				<div class="lr-ticket-strip" aria-label="Resumen de entradas">
					{publicTickets.map((ticket) => (
						<span>
							<strong>{ticket.label}</strong> {formatCLP(ticket.price)}
							{ticket.note && <small>{ticket.note}</small>}
						</span>
					))}
				</div>
			</div>
		</section>

		<section class="lr-section lr-section--tight" aria-labelledby="lr-access-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Antes y durante el evento</p>
				<h2 id="lr-access-title">Accesos útiles</h2>
			</div>
			<div class="lr-action-grid">
				<a class="lr-action" href="#programa">
					<span>Ver horarios</span>
					<small>Clase, social, presentaciones y cierre.</small>
				</a>
				<a class="lr-action" href={menuPath}>
					<span>Ver menú</span>
					<small>Comida confirmada en texto accesible.</small>
				</a>
				<a class="lr-action" href={event.contact.whatsappHref}>
					<span>Consultar a LatinRengo</span>
					<small>{event.contact.label}</small>
				</a>
			</div>
		</section>

		<section id="programa" class="lr-section" aria-labelledby="lr-schedule-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Programa público confirmado</p>
				<h2 id="lr-schedule-title">Cronograma</h2>
			</div>
			<div class="lr-program-block">
				<h3>Programa general</h3>
				<ol class="lr-timeline">
					{publicSchedule.map((item) => (
						<li>
							<time datetime={item.startDateTime}>{item.timeLabel}</time>
							<div>
								<h4>{item.title}</h4>
								{item.description && <p>{item.description}</p>}
							</div>
						</li>
					))}
				</ol>
			</div>

			<div class="lr-program-block lr-program-block--performances">
				<div class="lr-section__heading lr-section__heading--split">
					<div>
						<p class="lr-kicker">Bloque artístico</p>
						<h3>Orden de presentaciones</h3>
					</div>
					<p class="lr-note">Orden de presentaciones sujeto a cambios.</p>
				</div>
				<ol class="lr-performance-list">
					{publicPresentationSchedule.map((item, index) => (
						<li class:list={['lr-performance-item', `lr-performance-item--${item.kind}`]}>
							<time datetime={item.startDateTime}>{item.timeLabel}</time>
							{item.artistNumber && <span class="lr-performance-number">{item.artistNumber}</span>}
							<div class="lr-performance-item__body">
								<h4>{item.title}</h4>
								<p>{item.discipline ?? item.role}</p>
							</div>
							{item.artist?.image && item.artist.alt && (
								<div class="lr-performance-item__image">
									<Image
										src={item.artist.image}
										alt={item.artist.alt}
										widths={[96, 144, 240]}
										sizes="(min-width: 760px) 9rem, 5.5rem"
										loading={index < 2 ? 'eager' : 'lazy'}
										decoding="async"
									/>
								</div>
							)}
						</li>
					))}
				</ol>
			</div>
		</section>

		<section id="entradas" class="lr-section" aria-labelledby="lr-tickets-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Valores confirmados</p>
				<h2 id="lr-tickets-title">Entradas</h2>
			</div>
			<div class="lr-price-list">
				{publicTickets.map((ticket) => (
					<article class="lr-price-row">
						<div>
							<h3>{ticket.label}</h3>
							{ticket.note && <p>{ticket.note}</p>}
						</div>
						<strong>{formatCLP(ticket.price)}</strong>
					</article>
				))}
			</div>
			<a class="lr-primary-cta" href={event.contact.whatsappHref}>Consultar entradas por WhatsApp</a>
		</section>

		<section class="lr-section" aria-labelledby="lr-place-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Lugar confirmado</p>
				<h2 id="lr-place-title">Dónde es</h2>
			</div>
			<div class="lr-info-panel">
				<p><strong>{event.venueName}</strong></p>
			</div>
		</section>

		<section id="contacto" class="lr-section" aria-labelledby="lr-contact-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Contacto público</p>
				<h2 id="lr-contact-title">LatinRengo</h2>
			</div>
			<div class="lr-contact-panel">
				<p>{event.contact.label}</p>
				<a class="lr-primary-cta" href={event.contact.whatsappHref}>Escribir a LatinRengo</a>
			</div>
		</section>

		<section class="lr-section" aria-labelledby="lr-faq-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Preguntas frecuentes</p>
				<h2 id="lr-faq-title">Información rápida</h2>
			</div>
			<div class="lr-faq-list">
				{publicFaqItems.map((item) => (
					<details>
						<summary>{item.question}</summary>
						<p>{item.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section class="lr-section lr-section--relationship" aria-labelledby="lr-relation-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Relación con LatinRengo</p>
				<h2 id="lr-relation-title">Una comunidad, una noche especial</h2>
			</div>
			<p>
				LatinRengo Social es la guía pública del evento de aniversario. La página principal de
				LatinRengo mantiene su identidad de clases y comunidad regular.
			</p>
			<a href="/latin-rengo">Ir a LatinRengo</a>
		</section>
	</main>
	<footer data-latin-rengo class="lr-footer">
		<a href="/latin-rengo">LatinRengo</a>
		<a href={menuPath}>Menú del evento</a>
		<a href={archivePath}>Ver archivo de LatinRengo Social</a>
	</footer>
</LatinRengoSocialLayout>

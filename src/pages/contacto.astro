---
import { buildWhatsAppHref, SITE_CONTACT, SOCIAL_LINKS } from '../data/site';
import MainLayout from '../layouts/MainLayout.astro';
const joinHref = buildWhatsAppHref('Hola Elementos, quiero sumarme a entrenar. ¿Me cuentan los horarios, valores y cómo llegar?');
const address = 'Calle Nueva Tres 1036, Villa El Naranjal Viejo, Rengo';
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---
<style>
.contact-page{background:#f6f2e8;color:#14202d;padding:clamp(3rem,7vw,7rem) max(1.25rem,calc((100% - 1120px)/2));}.intro{max-width:820px;padding-bottom:3rem}.kicker{font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#0c4b7c}h1{font-size:clamp(2.8rem,7vw,5.8rem);line-height:1.04;letter-spacing:-.045em;margin:1rem 0 1.5rem}.lead{font-size:clamp(1.15rem,2vw,1.45rem);max-width:650px;line-height:1.6}.action{display:inline-block;padding:.95rem 1.2rem;background:#0c4b7c;color:white;border-radius:6px;font-weight:700;text-decoration:none;margin-top:1rem}.number{font-size:.95rem;color:#314152}.visit,.channels{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,5rem);padding:3rem 0;border-top:1px solid #14202d26}h2{font-size:clamp(1.9rem,4vw,3rem);line-height:1.15;letter-spacing:-.025em;margin:1rem 0}address{font-style:normal;font-size:1.2rem;font-weight:600;line-height:1.6}.visit p,.channels p{line-height:1.7}.first{background:#e8eee9;padding:clamp(1.5rem,4vw,2.5rem);border-radius:8px}.first h3{font-size:1.6rem;margin-top:0}.first ol{padding-left:1.3rem;line-height:1.7}.first li{padding-bottom:.75rem}.text-link{display:inline-block;color:#0c4b7c;font-weight:700;text-underline-offset:5px;margin-top:.5rem}.links a{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid #14202d26;font-size:1.2rem;color:#0c4b7c;text-decoration:none}.links a:hover{text-decoration:underline;text-underline-offset:5px}.email{font-size:.9rem;overflow-wrap:anywhere}.other{font-size:.9rem;border-top:1px solid #14202d26;padding-top:1.5rem;line-height:1.7}a:focus-visible{outline:3px solid #eb8e1d;outline-offset:5px}@media(max-width:700px){.visit,.channels{grid-template-columns:1fr;gap:1.5rem;padding:2rem 0}}
</style>

<MainLayout title="Ven a conocernos | Espacio Elementos" description="Escríbenos para entrenar en Espacio Elementos. WhatsApp, dirección en Rengo y redes para conocer nuestra comunidad." image="/images/banners/banner-1.png">
  <div class="contact-page">
    <header class="intro"><p class="kicker">Te esperamos en Rengo</p><h1>El primer paso<br />es conversar.</h1><p class="lead">¿Quieres entrenar, probar la lira o empezar a bailar? Cuéntanos qué te mueve y te ayudamos a sumarte.</p><a class="action" href={joinHref} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp ↗</a><p class="number">{SITE_CONTACT.whatsappLabel}</p></header>
    <section class="visit" aria-labelledby="visita">
      <div><p class="kicker">Nuestra casa</p><h2 id="visita">Nos encontramos aquí.</h2><address>{address}</address><p>Antes de venir, escríbenos para confirmar el horario de tu actividad, disponibilidad y las indicaciones de llegada.</p><a class="text-link" href={mapsHref} target="_blank" rel="noopener noreferrer">Buscar la dirección en el mapa ↗</a></div>
      <div class="first"><h3>Tu primera vez</h3><ol><li>Cuéntanos qué te gustaría practicar.</li><li>Consulta horarios, valores y disponibilidad.</li><li>Coordinamos tu visita y qué llevar.</li></ol><a class="text-link" href="/talleres">Conoce las prácticas →</a></div>
    </section>
    <section class="channels" aria-labelledby="redes"><div><p class="kicker">Seguimos en movimiento</p><h2 id="redes">Conoce nuestra vida<br />entre clases.</h2><p>Entrenamientos, baile, encuentros y recuerdos de la comunidad.</p></div><div class="links">{SOCIAL_LINKS.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true">↗</span></a>)}<a href={SITE_CONTACT.emailHref}>Escríbenos por correo<span aria-hidden="true">↗</span></a><p class="email">{SITE_CONTACT.email}</p></div></section>
    <p class="other">Para conversar sobre una presentación, una obra o una colaboración, también puedes escribirnos por correo.</p>
  </div>
</MainLayout>

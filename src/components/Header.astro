---
import { NAV_ITEMS } from '../data/site';
const path = Astro.url.pathname;
---
<header class="house-header">
  <div class="house-header__inner">
    <a class="house-brand" href="/" aria-label="Espacio Elementos · Inicio"><img src="/images/logo-espacio-elementos.png" alt="Espacio Elementos" width="270" height="77" /></a>
    <nav aria-label="Navegación principal">
      {NAV_ITEMS.map(item => <a href={item.href} class:list={{join:item.href === '/#unete'}} aria-current={item.href === '/historia' && path.startsWith('/historia') ? 'page' : undefined}>{item.label}{item.href === '/#unete' && <span aria-hidden="true"> ↗</span>}</a>)}
    </nav>
  </div>
</header>
<style>
.house-header{background:#f6f2e8;border-bottom:1px solid #14202d20;position:relative;z-index:10}.house-header__inner{width:min(1280px,calc(100% - 3rem));margin:auto;display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1.2rem 0}.house-brand{flex-shrink:0}.house-brand img{display:block;width:216px;height:auto}nav{display:flex;align-items:center;gap:2rem;font-size:.95rem;font-weight:700}nav a{padding:.65rem 0;white-space:nowrap}nav a:hover,nav a[aria-current]{text-decoration:underline;text-underline-offset:6px}nav .join{padding:.6rem 1.3rem;background:#0c4b7c;color:white;border-radius:4px}.join span{margin-left:1rem}a:focus-visible{outline:3px solid #eb8e1d;outline-offset:5px}@media(max-width:780px){.house-header__inner{width:calc(100% - 2.5rem);flex-direction:column;align-items:flex-start;gap:.8rem;padding:1rem 0}.house-brand img{width:175px}nav{width:100%;justify-content:space-between;gap:.7rem;font-size:.82rem}nav .join{padding:.55rem .8rem}.join span{margin-left:.35rem}}@media(max-width:360px){nav{font-size:.75rem;gap:.4rem}}
</style>
